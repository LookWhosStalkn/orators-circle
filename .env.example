# ── LiveKit ────────────────────────────────────────────────
# From your LiveKit Cloud project (https://cloud.livekit.io) or self-hosted server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIkey
LIVEKIT_API_SECRET=APIsecret

# Passcode hosts need to enter to create/manage a room, and admins use for the
# management panel. CHANGE THIS before going public.
HOST_PASSCODE=host

# ── Server ─────────────────────────────────────────────────
PORT=3000

# ── Recording output (optional) ────────────────────────────
# LiveKit Cloud REQUIRES S3 for recording. Self-hosted servers can omit this
# and recordings are written to the egress file path on the server.
# S3_ACCESS_KEY=
# S3_SECRET=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_KEY_PREFIX=recordings/

# ── Webhooks (optional) ────────────────────────────────────
# Set in LiveKit Cloud console -> Webhooks. Used to clean up when rooms end.
# LIVEKIT_WEBHOOK_SECRET=
